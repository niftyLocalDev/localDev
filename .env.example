# Cloud Run supplies PORT automatically.
PORT=8080
NODE_ENV=development

# Add the OAuth client ID after the first Cloud Run deployment.
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URI=
AUTHORIZED_EMAIL=

# These values will be mounted from Secret Manager in Cloud Run.
OAUTH_CLIENT_SECRET=
PLACES_API_KEY=
OAUTH_REFRESH_TOKEN_SECRET=google-oauth-refresh-token

# BigQuery configuration.
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=gmb_data

